{
  "name": "@luminascale/pi-shepherd",
  "version": "0.1.0",
  "type": "module",
  "description": "No-fuss pi extension: subagents + herding pi agents in Herdr",
  "license": "Apache-2.0",
  "homepage": "https://github.com/MikkelKappelPersson/pi-shepherd#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MikkelKappelPersson/pi-shepherd.git"
  },
  "bugs": {
    "url": "https://github.com/MikkelKappelPersson/pi-shepherd/issues"
  },
  "keywords": [
    "pi-package",
    "pi",
    "pi-agent",
    "extension",
    "subagent",
    "subagents",
    "agent",
    "agents",
    "herdr",
    "shepherd",
    "sheep",
    "artifacts",
    "fieldnotes"
  ],
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "scripts": {
    "clean": "echo 'nothing to clean'",
    "build": "echo 'nothing to build'",
    "check": "echo 'nothing to check'",
    "discovery:test": "node --experimental-strip-types --disable-warning=ExperimentalWarning test/verify-discovery.mjs",
 "schemas:test": "node --experimental-strip-types --disable-warning=ExperimentalWarning test/verify-tool-schemas.mjs",
    "cli:test": "node --experimental-strip-types --disable-warning=ExperimentalWarning test/verify-cli.mjs",
    "parent-surface:test": "node --experimental-strip-types --disable-warning=ExperimentalWarning test/verify-parent-surface.mjs",
    "command-ux:test": "node --experimental-strip-types --disable-warning=ExperimentalWarning test/verify-command-ux.mjs",
    "launch:test": "node --experimental-strip-types --disable-warning=ExperimentalWarning test/verify-launch.mjs",
    "effective-prompt:test": "node --experimental-strip-types --disable-warning=ExperimentalWarning test/verify-effective-prompt.mjs",
    "registry:test": "node --experimental-strip-types --disable-warning=ExperimentalWarning test/verify-registry.mjs",
    "multi-wait:test": "node --experimental-strip-types --disable-warning=ExperimentalWarning test/verify-multi-wait.mjs",
    "artifact-sessions:test": "node --experimental-strip-types --disable-warning=ExperimentalWarning test/verify-artifact-sessions.mjs",
    "settings:test": "node --experimental-strip-types --disable-warning=ExperimentalWarning test/verify-settings.mjs",
    "show:shepherd-prompt": "node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/show-shepherd-prompt.mjs",
    "show:shepherd-orchestrator": "node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/show-shepherd-orchestrator.mjs",
    "extract:system-prompt": "node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/extract-pi-system-prompt.mjs",
    "test": "npm run schemas:test && npm run cli:test && npm run parent-surface:test && npm run command-ux:test && npm run discovery:test && npm run launch:test && npm run effective-prompt:test && npm run registry:test && npm run multi-wait:test && npm run artifact-sessions:test && npm run settings:test"
  },
  "peerDependencies": {
    "@earendil-works/pi-agent-core": "*",
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  }
}
