# Editors / OS
.DS_Store
.idea/
.vscode/
*.swp

# Logs / temp
*.log

# Local development state for the package itself. This repo *is* pi-shepherd,
# not a project that consumes it, so its own .shepherd/ (dev settings plus
# runtime fieldnote sessions) is never published. User projects that want to
# share a project config should instead use the pattern documented in README:
#   .shepherd/*
#   !.shepherd/config.json
.shepherd/

# Locally installed project skills
.agents/skills/
skills-lock.json
